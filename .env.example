# ==============================================================================
# PayBridge AI - Server Environment Configuration Template
# Cross-Border Trade Workflow Prototype (Server Loads Root .env First, Then server/.env)
# ==============================================================================

# Server Port
PORT=3001

# Render Postgres connection URL. On Render, the API uses the private Virginia
# hostname for a matching Render external URL; locally, use the external URL.
# Leave blank for local in-memory development. Never commit a real connection string.
DATABASE_URL=

# Optional initial demo role passwords (server only; at least 12 characters each).
# On first database start, these are hashed and imported into paybridge_users.
# Existing database passwords are never overwritten by these values.
PAYBRIDGE_PASSWORD_A1_TRADER=
PAYBRIDGE_PASSWORD_A1_APPROVER=
PAYBRIDGE_PASSWORD_B1_TRADER=
PAYBRIDGE_PASSWORD_B1_APPROVER=
PAYBRIDGE_PASSWORD_REGA=
PAYBRIDGE_PASSWORD_REGB=
PAYBRIDGE_PASSWORD_AUDITOR=

# ------------------------------------------------------------------------------
# 1. PayPal Developer Platform (Sandbox Credentials)
# ------------------------------------------------------------------------------
# Get your Sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# If left empty (or PAYPAL_MODE=mock), runs in clearly labeled simulation mode
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 2. AI Reasoning Engine (Google Gemini 2.5 Flash)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Channel3 Sourcing & Product Intelligence (100M+ Products Catalog)
# ------------------------------------------------------------------------------
# Sign up at: https://trychannel3.com/developers
CHANNEL3_API_KEY=your_channel3_api_key_here
CHANNEL3_API_URL=https://api.trychannel3.com/v1/search

# ------------------------------------------------------------------------------
# 4. Elastic Cloud (Serverless Vector Search & ES|QL)
# ------------------------------------------------------------------------------
ELASTIC_ENDPOINT=https://your-deployment.es.region.gcp.elastic.cloud:443
ELASTIC_API_KEY=your_elastic_api_key_here

# ------------------------------------------------------------------------------
# 5. KERNEL Cloud Browser Infrastructure
# ------------------------------------------------------------------------------
KERNEL_API_BASE=https://api.onkernel.com/v1

# ------------------------------------------------------------------------------
# 6. Zapier MCP Multi-App Automation Gateway
# ------------------------------------------------------------------------------
ZAPIER_MCP_SERVER_URL=https://mcp.zapier.com/v1
# Optional outbound Zapier Catch webhook (separate from the Zapier MCP server URL).
ZAPIER_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 7. Multi-Agent Risk & Threshold Parameters
# ------------------------------------------------------------------------------
FRAUD_THRESHOLD=1000.0
RISK_SCORE_THRESHOLD=7.0
POLL_INTERVAL=5

# ------------------------------------------------------------------------------
# 8. Optional Hyperledger Fabric Gateway
# ------------------------------------------------------------------------------
# Run npm run fabric:configure after starting the local Fabric network.
FABRIC_GATEWAY_ENABLED=false
FABRIC_HOST=127.0.0.1
FABRIC_PEER_PORT=9051
FABRIC_TLS_SERVER_NAME=peer0.banka1.consortium.local
FABRIC_MSP_ID=BankA1MSP
FABRIC_CHANNEL=settlement
FABRIC_CHAINCODE=settlement-cc
# Read identity. For BankA1 writes, set FABRIC_BANKA1_* explicitly below;
# FABRIC_USER_* remains supported as a BankA1 compatibility fallback.
FABRIC_USER_CERT_FILE=path/to/rotated/identity/cert.pem
FABRIC_USER_KEY_FILE=path/to/rotated/identity/key.pem
FABRIC_TLS_CA_FILE=path/to/current/peer/tls/ca.crt
# Alternative secret variables: FABRIC_USER_CERT_BASE64, FABRIC_USER_KEY_BASE64, FABRIC_TLS_CA_BASE64
# Ledger mutations require this additional explicit opt-in and a second bank identity.
FABRIC_GATEWAY_WRITE_ENABLED=false
# Generate a random secret of at least 32 characters; enter it in the UI only for an authorized demo operator.
FABRIC_WRITE_API_TOKEN=
# These must be rotated, least-privilege demo identities. Never commit their values.
FABRIC_BANKA1_CERT_FILE=path/to/rotated/banka1/cert.pem
FABRIC_BANKA1_KEY_FILE=path/to/rotated/banka1/key.pem
FABRIC_BANKB1_CERT_FILE=path/to/rotated/bankb1/cert.pem
FABRIC_BANKB1_KEY_FILE=path/to/rotated/bankb1/key.pem
# Alternative: FABRIC_BANKA1_CERT_BASE64, FABRIC_BANKA1_KEY_BASE64,
# FABRIC_BANKB1_CERT_BASE64, FABRIC_BANKB1_KEY_BASE64

# Browser-exposed values belong in client/.env, not this server-side file.
