# PayBridge AI Environment Configuration

# Server Port
PORT=3001

# PayPal Sandbox API Credentials
# Leave empty to run in Zero-Config High-Fidelity Simulation Mode (Instant evaluation for judges)
# Or provide your free PayPal Developer Sandbox credentials:
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI Model Configuration
# Optional: Provide Gemini or OpenAI key for live dynamic responses.
# Built-in autonomous multi-agent swarm heuristics operate out-of-the-box if omitted.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Client PayPal Client ID (Used by PayPal Smart Buttons SDK)
# Defaults to "test" in sandbox/simulation mode
VITE_PAYPAL_CLIENT_ID=test
VITE_API_URL=http://localhost:3001
