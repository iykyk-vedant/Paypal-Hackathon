# AWS EC2 Fabric Connection Template
# Use this in Render or local API to point to your live AWS-hosted Fabric network

FABRIC_HOST=ec2-your-instance-ip.compute-1.amazonaws.com
FABRIC_PEER_PORT=9051
FABRIC_ORDERER_PORT=7050
FABRIC_CHANNEL=settlement
FABRIC_CHAINCODE=settlement-cc
FABRIC_MSP=BankA1MSP
FABRIC_TLS_ENABLED=true
