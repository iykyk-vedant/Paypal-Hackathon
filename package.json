{
  "name": "paybridge-ai",
  "version": "1.0.0",
  "description": "PayBridge AI: Autonomous Agentic Commerce & Cross-Border Treasury Protocol with PayPal Sandbox & AG Grid",
  "private": true,
  "scripts": {
    "setup": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "paypal",
    "ai",
    "agentic-commerce",
    "ag-grid",
    "cross-border",
    "treasury",
    "fintech",
    "hackathon"
  ],
  "author": "Vedant Gharat",
  "license": "MIT"
}
